   }
  ],
  "schema": {
   "type": "object",
   "properties": {
    "schemaVersion": {
     "type": "integer"
    },
    "nextId": {
     "type": "integer",
     "minimum": 1
    },
    "apps": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
