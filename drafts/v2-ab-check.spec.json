   "required": [
    "schemaVersion",
    "nextId",
    "apps"
   ]
  },
  "initial": {
   "schemaVersion": 2,
   "nextId": 1,
   "apps": []
  },
  "migrations": [
   {
    "from": 1,
    "to": 2,
    "cel": "{'schemaVersion': 2, 'nextId': saved.nextId, 'v1Backup': saved, 'apps': saved.apps.map(a, {'id': a.id, 'company': a.company, 'role': a.role, 'appliedOn': a.appliedOn, 'status': a.status, 'notes': has(a.notes) ? a.notes : '', 'stages': [{'stage': a.status, 'date': a.appliedOn}]})}"
   }
  ],
  "personal": [
   "/apps"
  ]
 },
 "logic": {
  "consts": {},
  "functions": {
   "newestFirst": {
    "params": [
     "acc",
     "a"
    ],
    "cel": "[a] + acc"
   },
   "findStep": {
    "params": [
     "acc",
     "a"
    ],
    "cel": "{'n': acc.n + 1, 'at': has(a.id) && a.id == acc.id ? acc.n : acc.at, 'id': acc.id}"
   },
   "indexOfId": {
    "params": [
     "apps",
     "id"
    ],
    "cel": "fold(apps, {'n': 0, 'at': -1, 'id': id}, 'findStep').at"
   },
   "countText": {
    "params": [
     "n"
    ],
    "cel": "string(n) + (n == 1 ? ' application' : ' applications')"
   },
   "missingHint": {
    "params": [
     "company",
     "role"
    ],
    "cel": "company == '' && role == '' ? 'Add the company and role to save.' : company == '' ? 'Add the company to save.' : role == '' ? 'Add the role to save.' : ''"
   },
   "toRow": {
    "params": [
     "acc",
     "a"
    ],
    "cel": "acc + [{'num': acc.size() + 1, 'id': a.id, 'company': a.company, 'role': a.role, 'status': a.status, 'appliedOn': a.appliedOn, 'statusList': [a.status]}]"
   },
   "pickStatus": {
    "params": [
     "chosen",
     "fallback"
    ],
    "cel": "chosen.size() > 0 ? chosen[0] : fallback"
   },
   "nextStages": {
    "params": [
     "stages",
     "status",
     "day"
    ],
    "cel": "stages.size() > 0 && stages[stages.size() - 1].stage == status ? stages : stages + [{'stage': status, 'date': day}]"
   },
   "migrateV1": {
    "params": [
     "saved"
    ],
    "cel": "{'schemaVersion': 2, 'nextId': saved.nextId, 'v1Backup': saved, 'apps': saved.apps.map(a, {'id': a.id, 'company': a.company, 'role': a.role, 'appliedOn': a.appliedOn, 'status': a.status, 'notes': has(a.notes) ? a.notes : '', 'stages': [{'stage': a.status, 'date': a.appliedOn}]})}"
   }
  },
  "computed": {
   "/computed/selIndex": "indexOfId(saved.apps, ui.selId)",
   "/computed/afterNextId": "saved.nextId + 1",
   "/computed/countText": "countText(saved.apps.size())",
   "/computed/isList": "ui.mode == 'list' ? [{'shown': true}] : []",
   "/computed/isAdd": "ui.mode == 'add' ? [{'shown': true}] : []",
   "/computed/isEdit": "ui.mode == 'edit' ? [{'shown': true}] : []",
   "/computed/empty": "ui.mode == 'list' && saved.apps.size() == 0 ? [{'text': 'No applications yet. Tap Add application to log the first one you sent.'}] : []",
   "/computed/always": "[{'shown': true}]",
   "/computed/listRows": "ui.mode == 'list' ? fold(fold(saved.apps, [], 'newestFirst'), [], 'toRow') : []",
   "/computed/addHint": "missingHint(ui.draft.company, ui.draft.role)",
   "/computed/editHint": "ui.mode == 'edit' ? missingHint(ui.edit.company, ui.edit.role) : ''",
   "/computed/draftStatus": "pickStatus(ui.draftStatusList, 'Applied')",
   "/computed/draftStages": "[{'stage': pickStatus(ui.draftStatusList, 'Applied'), 'date': ui.draft.appliedOn}]",
   "/computed/editStatus": "ui.mode == 'edit' ? pickStatus(ui.editStatusList, ui.edit.status) : ''",
   "/computed/editStages": "ui.mode == 'edit' ? nextStages(has(ui.edit.stages) ? ui.edit.stages : [], pickStatus(ui.editStatusList, ui.edit.status), today) : []",
   "/computed/editHistory": "ui.mode == 'edit' && has(ui.edit.stages) ? ui.edit.stages : []"
  },
