    }
   ]
  }
 ],
 "promises": [
  {
   "id": "P-1",
   "text": "Applications saved on this phone survive a reload and an update, and each one saved before stages existed gets one stage from its status and date applied",
   "kind": "data"
  },
  {
   "id": "P-2",
   "text": "Each application has exactly one status at a time, and the status picker shows it whatever field has focus"
  },
  {
   "id": "P-3",
   "text": "Changing one application never changes another"
  },
  {
   "id": "P-4",
   "text": "An application's status always matches its latest stage"
  }
 ],
