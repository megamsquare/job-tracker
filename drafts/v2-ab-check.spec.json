   "id": "list",
   "says": "Every application, newest first and numbered: company, then role, status and the date applied.",
   "states": {
    "empty": "No applications yet. Tap Add application to log the first one you sent."
   }
  },
  {
   "id": "add",
   "says": "A form for a new application: company, role, date applied (today unless changed), status and notes."
  },
  {
   "id": "edit",
   "says": "The same form for one application, with its stage history oldest first; Done saves a new stage when the status changed and goes back to the list."
  }
 ],
 "journeys": [
  {
   "id": "J-1",
   "title": "Log an application",
   "steps": [
    {
     "id": "J-1.1",
     "text": "Tap Add application and fill in the company, role, date applied, status and notes"
    },
    {
     "id": "J-1.2",
     "text": "Tap Save to see it at the top of the list, numbered, with its role, status and date applied"
    }
   ]
  },
  {
   "id": "J-2",
   "title": "Update an application",
   "steps": [
    {
     "id": "J-2.1",
     "text": "Tap an application in the list to open it"
    },
    {
     "id": "J-2.2",
     "text": "Change its status or details, then tap Done to see the change in the list"
    },
    {
     "id": "J-2.3",
     "text": "See its stage history, oldest first: a status change adds a stage dated today, and Done with the same status adds nothing"
    }
   ]
  },
  {
   "id": "J-3",
   "title": "Start with nothing saved",
   "steps": [
    {
     "id": "J-3.1",
